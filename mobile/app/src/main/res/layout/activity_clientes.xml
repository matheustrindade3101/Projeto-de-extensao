<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/spacing_medium"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/golden_amber"
            android:textSize="@dimen/text_size_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/clients_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_extra_small"
            android:text="@string/clients_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body" />

        <EditText
            android:id="@+id/editSearchClient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_min_height"
            android:layout_marginTop="@dimen/spacing_extra_large"
            android:background="@drawable/background_input"
            android:hint="@string/clients_search_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/text_size_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNewClient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/new_client"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:backgroundTint="@color/golden_amber"
            app:cornerRadius="@dimen/radius_medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFilterAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/spacing_extra_small"
                android:layout_weight="1"
                android:text="@string/filter_all"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/brick_red"
                app:cornerRadius="@dimen/radius_large" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFilterActive"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_extra_small"
                android:layout_marginEnd="@dimen/spacing_extra_small"
                android:layout_weight="1"
                android:text="@string/filter_active"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/deep_teal"
                app:cornerRadius="@dimen/radius_large" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFilterInactive"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_extra_small"
                android:layout_weight="1"
                android:text="@string/filter_inactive"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/deep_teal"
                app:cornerRadius="@dimen/radius_large" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerClients"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_extra_large" />

        <LinearLayout
            android:id="@+id/emptyClientsState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/clients_empty_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@string/clients_empty_message"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
