
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F7F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Botão Voltar -->
        <Button
            android:id="@+id/botaoVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textAllCaps="false" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Novo cliente"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <!-- Descrição -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preencha os dados do cliente."
            android:textSize="14sp"
            android:textColor="#666666" />

        <!-- Campo Nome -->
        <EditText
            android:id="@+id/campoNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Nome completo *"
            android:inputType="textPersonName" />

        <!-- Campo Telefone -->
        <EditText
            android:id="@+id/campoTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Telefone *"
            android:inputType="phone" />

        <!-- Campo E-mail -->
        <EditText
            android:id="@+id/campoEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="E-mail *"
            android:inputType="textEmailAddress" />

        <!-- Campo Data de Nascimento -->
        <EditText
            android:id="@+id/campoNascimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Data de nascimento (DD/MM/AAAA) *"
            android:inputType="date"
            android:maxLength="10" />

        <!-- Botão Salvar -->
        <Button
            android:id="@+id/botaoSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Salvar cliente"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
